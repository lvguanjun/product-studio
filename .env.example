# Required: API key for image generation (OPENAI_API_KEY is also supported)
API_KEY=your-api-key-here

# Required: shared Basic Auth key (used as both username and password)
ACCESS_KEY=your-access-key-here

# Optional: override the default OpenAI-compatible gateway URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: local monthly budget tracking & threshold circuit breaker (USD)
# MONTHLY_BUDGET_USD=25
# BALANCE_WARN_THRESHOLD_USD=5.0
# BALANCE_DISABLE_THRESHOLD_USD=1.0
# BILLING_TIMEZONE=UTC
# Optional: manual offset for external usage within a billing month
# BALANCE_USED_OFFSET_USD=0
# BALANCE_USED_OFFSET_MONTH=2026-11
